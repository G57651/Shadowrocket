<Window x:Class="Shadowrocket.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Shadowrocket.Views"
        Title="Shadowrocket" Width="1120" Height="720" MinWidth="920" MinHeight="640"
        Icon="app.ico"
        Background="{DynamicResource PageBgBrush}"
        FontFamily="{DynamicResource FontDefault}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <!-- Windows 原生标题栏（用户选择），窗口内是蓝色标题条 + 胶囊导航 + 页面内容 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 蓝色标题条：胶囊 Tab 导航 -->
        <Border Grid.Row="0" Background="{DynamicResource BrandBrush}" Padding="0,10,0,10">
            <Grid>
                <StackPanel HorizontalAlignment="Center">
                    <Border Background="{DynamicResource BrandDeepBrush}" CornerRadius="20" Height="40" Padding="4,0">
                        <ListBox x:Name="NavTabs" Background="Transparent" BorderThickness="0"
                                 ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource PillTabItem}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource PillTabText}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 页面内容 -->
        <Grid Grid.Row="1">
            <views:HomeView x:Name="HomePage" Visibility="Collapsed" />
            <views:ConfigView x:Name="ConfigPage" Visibility="Collapsed" />
            <views:DataView x:Name="DataPage" Visibility="Collapsed" />
            <views:SettingsView x:Name="SettingsPage" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
