<Application x:Class="Shadowrocket.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Shadowrocket.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 主题令牌：M1 默认浅色；ThemeMode 切换时在运行时替换为 Tokens.Dark.xaml -->
                <ResourceDictionary Source="Themes/Tokens.Light.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:EnumEqualConverter x:Key="EnumEqualConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
            <conv:RunningTextConverter x:Key="RunningTextConverter" />
            <conv:RunningBadgeConverter x:Key="RunningBadgeConverter" />
            <conv:CurrentNodeBorderConverter x:Key="CurrentNodeBorderConverter" />
            <conv:PercentToGridLengthConverter x:Key="PercentToGridLengthConverter" />
            <conv:StringToBrushConverter x:Key="StringToBrushConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
