<Window x:Class="Shadowrocket.Views.SubscriptionDetailDialog" Icon="pack://application:,,,/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="订阅详情" Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource PageBgBrush}" FontFamily="{DynamicResource FontDefault}">
    <StackPanel Margin="20">
        <TextBlock Text="备注名称" Style="{StaticResource SubText}" />
        <TextBox x:Name="NameBox" Margin="0,6,0,14" Padding="8,7" FontSize="14"
                 Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" />

        <TextBlock Text="订阅地址" Style="{StaticResource SubText}" />
        <Grid Margin="0,6,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="UrlBox" IsReadOnly="True" Padding="8,7" FontSize="12"
                     Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                     BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" />
            <Button Grid.Column="1" Content="复制链接" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="CopyUrl_Click" />
        </Grid>

        <TextBlock Text="流量与更新" Style="{StaticResource SubText}" />
        <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="12" Margin="0,6,0,14">
            <StackPanel>
                <TextBlock x:Name="TrafficText" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="ExpireText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                <TextBlock x:Name="UpdatedText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Text="自动更新" Style="{StaticResource SubText}" />
        <Border Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="12" Margin="0,6,0,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ModeOffButton" Style="{StaticResource GhostButton}" Click="Mode_Click" Tag="off" />
                    <Button x:Name="ModeIntervalButton" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="Mode_Click" Tag="interval" />
                    <Button x:Name="ModeDailyButton" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="Mode_Click" Tag="daily" />
                    <Button x:Name="ModeCronButton" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="Mode_Click" Tag="cron" />
                </StackPanel>
                <Grid Margin="0,10,0,0">
                    <StackPanel x:Name="IntervalPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBox x:Name="IntervalBox" Width="70" Padding="8,6" FontSize="13"
                                 Background="{DynamicResource PageBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" VerticalContentAlignment="Center" />
                        <TextBlock Text="分钟（5-10080）" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="DailyPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBox x:Name="TimeBox" Width="90" Padding="8,6" FontSize="13"
                                 Background="{DynamicResource PageBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" VerticalContentAlignment="Center" />
                        <TextBlock Text="每天该时间自动更新（HH:mm）" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                    <StackPanel x:Name="CronPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBox x:Name="CronBox" Width="200" Padding="8,6" FontSize="13" FontFamily="{DynamicResource FontMono}"
                                 Background="{DynamicResource PageBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                 BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" VerticalContentAlignment="Center" />
                        <TextBlock Text="5 段式：分 时 日 月 周" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="删除订阅" Style="{StaticResource GhostButton}" Foreground="{DynamicResource DangerBrush}"
                    HorizontalAlignment="Left" Click="Delete_Click" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="立即更新" Style="{StaticResource GhostButton}" Click="Update_Click" />
                <Button Content="保存" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
