<Window x:Class="Shadowrocket.Views.GroupDetailDialog" Icon="pack://application:,,,/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="策略组" Width="560" Height="640" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBgBrush}" FontFamily="{DynamicResource FontDefault}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="GroupName" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
            <Border Style="{StaticResource ProtoPill}" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="GroupType" Style="{StaticResource ProtoPillText}" />
            </Border>
            <TextBlock x:Name="GroupNow" Style="{StaticResource SubText}" Margin="10,0,0,0" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" MaxWidth="200" />
        </StackPanel>

        <!-- 组内测速：一次请求测完整组 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <TextBlock x:Name="TestHint" Style="{StaticResource SubText}" VerticalAlignment="Center" />
            <Button x:Name="TestAllButton" Content="⟳ 测速全部" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Right" Click="TestAll_Click" />
        </Grid>

        <ListBox x:Name="Members" Grid.Row="2" Background="{DynamicResource CardBrush}" BorderThickness="0"
                 FontSize="13.5" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 MouseDoubleClick="Members_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="490">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                        <TextBlock Grid.Column="1" Text="当前" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Grid.Column="2" Text="{Binding DelayText}" FontFamily="{DynamicResource FontMono}"
                                   FontSize="12.5" VerticalAlignment="Center" Width="72" TextAlignment="Right">
                            <TextBlock.Foreground>
                                <Binding Path="DelayColorText" Mode="OneWay" />
                            </TextBlock.Foreground>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="10,7" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="选中项测速" Style="{StaticResource GhostButton}" Click="TestOne_Click" />
            <Button Content="切换到此节点" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Select_Click" />
        </StackPanel>
    </Grid>
</Window>
