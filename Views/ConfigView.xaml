<UserControl x:Class="Shadowrocket.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14,16,16">
        <StackPanel>

            <!-- 订阅组（真实：profiles.json + /providers/proxies 订阅流量） -->
            <TextBlock Text="订阅" Style="{StaticResource GroupHeaderText}" />
            <ItemsControl ItemsSource="{Binding Profiles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Padding="16,12" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- Button 承载点击：鼠标、键盘、读屏都能打开订阅详情 -->
                                <Button Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch"
                                        Cursor="Hand" HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="{Binding Name, StringFormat=订阅 {0}}"
                                        Click="ProfileCard_Click" Tag="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid Background="Transparent">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeBody}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding Source}" Style="{StaticResource SubText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="›" FontSize="16" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Grid Margin="0,8,0,0">
                                    <TextBlock Text="{Binding TrafficText}" Style="{StaticResource SubText}" />
                                    <TextBlock Text="{Binding ExpireText}" Style="{StaticResource SubText}" HorizontalAlignment="Right" />
                                </Grid>
                                <Border Height="4" CornerRadius="2" Background="{DynamicResource SeparatorBrush}" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Percent, Converter={StaticResource PercentToGridLengthConverter}}" />
                                            <ColumnDefinition Width="{Binding Remainder, Converter={StaticResource PercentToGridLengthConverter}}" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="2" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding UpdatedText}" Style="{StaticResource SubText}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="+ 添加订阅" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                    Margin="0,4,0,0" Command="{Binding AddSubscriptionCommand}" />

            <!-- 代理组（真实：/proxies） -->
            <TextBlock Text="代理组" Style="{StaticResource GroupHeaderText}" Margin="16,22,0,8" />
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Height="44" Cursor="Hand" HorizontalContentAlignment="Stretch"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    AutomationProperties.Name="{Binding Name, StringFormat=组:{0}}"
                                    Click="GroupRow_Click" Tag="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid Height="44" Margin="16,0" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <Border Style="{StaticResource ProtoPill}" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource ProtoPillText}" Text="{Binding TypeName}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Count, StringFormat={}{0} 个节点}" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Now}" Style="{StaticResource SubText}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                        <TextBlock Text="›" FontSize="16" Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- 规则（M3 提供编辑；此处显示真实条数） -->
            <TextBlock Text="规则" Style="{StaticResource GroupHeaderText}" Margin="16,22,0,8" />
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <Button Height="44" Cursor="Hand" HorizontalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            AutomationProperties.Name="规则列表"
                            Click="RulesRow_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Margin="16,0" Background="Transparent">
                                    <TextBlock Text="规则列表" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RuleCount, StringFormat={}{0} 条}" Style="{StaticResource SubText}" />
                                        <TextBlock Text="›" FontSize="16" Foreground="{DynamicResource TextTertiaryBrush}" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="56,0,0,0" />
                    <!-- 当前路由模式：点击弹出切换（与首页同一套 PATCH /configs） -->
                    <Button Height="44" Cursor="Hand" HorizontalContentAlignment="Stretch"
                            Background="Transparent" BorderThickness="0" Padding="0"
                            AutomationProperties.Name="切换路由模式"
                            Click="RouteRow_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Margin="16,0" Background="Transparent">
                                    <TextBlock Text="当前路由模式" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RouteModeText}" Style="{StaticResource SubText}" />
                                        <TextBlock Text="›" FontSize="16" Foreground="{DynamicResource TextTertiaryBrush}" Margin="10,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="RouteMenu">
                                <MenuItem Header="规则模式" Command="{Binding SetRouteCommand}" CommandParameter="rule" />
                                <MenuItem Header="全局模式" Command="{Binding SetRouteCommand}" CommandParameter="global" />
                                <MenuItem Header="直连模式" Command="{Binding SetRouteCommand}" CommandParameter="direct" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
