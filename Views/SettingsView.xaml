<UserControl x:Class="Shadowrocket.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 行高 40 紧凑两列（ui-spec §3.4），全部行接真实设置项 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14,16,16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左列 ===== -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="通用" Style="{StaticResource GroupHeaderText}" />
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="主题" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="{Binding ThemeLightLabel}" Style="{StaticResource GhostButton}" Command="{Binding ThemeChanged}" CommandParameter="light" />
                                <Button Content="{Binding ThemeDarkLabel}" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding ThemeChanged}" CommandParameter="dark" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="16,0" />
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="自动测速" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <CheckBox Style="{StaticResource IosSwitch}" IsChecked="{Binding S.AutoSpeedTest, Mode=TwoWay}" Command="{Binding AutoSpeedTestChanged}" />
                                <TextBox Text="{Binding AutoSpeedTestIntervalText, UpdateSourceTrigger=PropertyChanged}" Width="52" Padding="6,3" FontFamily="{DynamicResource FontMono}" Margin="10,0,0,0"
                                         Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" VerticalContentAlignment="Center" />
                                <Button Content="{Binding AutoSpeedTestMinuteLabel}" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding AutoSpeedTestUnitChanged}" CommandParameter="minute" />
                                <Button Content="{Binding AutoSpeedTestSecondLabel}" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding AutoSpeedTestUnitChanged}" CommandParameter="second" />
                                <Button Content="应用" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding ApplyAutoSpeedTestCommand}" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="16,0" />
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="自动测延迟" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <CheckBox Style="{StaticResource IosSwitch}" IsChecked="{Binding S.AutoLatencyTest, Mode=TwoWay}" Command="{Binding AutoLatencyTestChanged}" />
                                <TextBox Text="{Binding AutoLatencyTestIntervalText, UpdateSourceTrigger=PropertyChanged}" Width="52" Padding="6,3" FontFamily="{DynamicResource FontMono}" Margin="10,0,0,0"
                                         Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" VerticalContentAlignment="Center" />
                                <Button Content="{Binding AutoLatencyTestMinuteLabel}" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding AutoLatencyTestUnitChanged}" CommandParameter="minute" />
                                <Button Content="{Binding AutoLatencyTestSecondLabel}" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding AutoLatencyTestUnitChanged}" CommandParameter="second" />
                                <Button Content="应用" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding ApplyAutoLatencyTestCommand}" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="16,0" />
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="节点排序" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="{Binding NodeSortDefaultLabel}" Style="{StaticResource GhostButton}" Command="{Binding NodeSortChanged}" CommandParameter="default"
                                        ToolTip="顺序规则：已测出下载速度的优先，未测的按延迟，两者都无的最后" />
                                <Button Content="{Binding NodeSortNameLabel}" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding NodeSortChanged}" CommandParameter="name" />
                                <Button Content="{Binding NodeSortLatencyLabel}" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding NodeSortChanged}" CommandParameter="latency" />
                                <Button Content="{Binding NodeSortSpeedLabel}" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding NodeSortChanged}" CommandParameter="speed" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="16,0" />
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="实时速率刷新间隔" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="{Binding SpeedInterval1Label}" Style="{StaticResource GhostButton}" Command="{Binding SpeedIntervalChanged}" CommandParameter="1" />
                                <Button Content="{Binding SpeedInterval5Label}" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding SpeedIntervalChanged}" CommandParameter="5" />
                                <Button Content="{Binding SpeedInterval10Label}" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding SpeedIntervalChanged}" CommandParameter="10" />
                                <Button Content="{Binding SpeedInterval30Label}" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding SpeedIntervalChanged}" CommandParameter="30" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="16,0" />
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="开机自启" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <CheckBox Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding S.AutoStart, Mode=TwoWay}" Command="{Binding AutoStartChanged}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="16,0" />
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="关闭到托盘" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="点窗口 × 时隐藏到托盘而不退出" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <CheckBox Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding S.CloseToTray, Mode=TwoWay}" Command="{Binding CloseToTrayChanged}" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="16,0" />
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="混合端口" ToolTip="HTTP 与 SOCKS5 共用的本地代理端口"
                                       FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" Width="70" Padding="6,3" FontFamily="{DynamicResource FontMono}"
                                         Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" VerticalContentAlignment="Center" />
                                <Button Content="应用" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding ApplyPortCommand}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="网络" Style="{StaticResource GroupHeaderText}" Margin="16,22,0,8" />
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Height="40" Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="TUN 模式" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="在首页开关切换 · 首次开启自动下载 wintun 驱动（需管理员授权）" Style="{StaticResource SubText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="16,0,0,0" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="16,0" />
                        <Grid Height="40" Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="系统代理" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="在首页开关切换" Style="{StaticResource SubText}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="16,0,0,0" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="16,0" />
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="允许局域网" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="开放代理给局域网内的其他设备" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <CheckBox Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding S.AllowLan, Mode=TwoWay}" Command="{Binding NetworkOptionChanged}" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="16,0" />
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="IPv6" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <CheckBox Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding S.Ipv6, Mode=TwoWay}" Command="{Binding NetworkOptionChanged}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="16,0" />
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="DNS (Fake-IP)" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="域名解析走 Fake-IP，防污染" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <CheckBox Style="{StaticResource IosSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          IsChecked="{Binding S.DnsFakeIp, Mode=TwoWay}" Command="{Binding NetworkOptionChanged}" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="16,0" />
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="分流规则" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="{Binding RuleModeStandardLabel}" Style="{StaticResource GhostButton}" Command="{Binding RuleModeChanged}" CommandParameter="standard" />
                                <Button Content="{Binding RuleModeAirportLabel}" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding RuleModeChanged}" CommandParameter="airport" />
                                <Button Content="{Binding RuleModeMinimalLabel}" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding RuleModeChanged}" CommandParameter="minimal" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="16,0" />
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="全局路由" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="规则 / 全局 / 直连，在首页切换" Style="{StaticResource SubText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="高级" Style="{StaticResource GroupHeaderText}" Margin="16,22,0,8" />
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="延迟探测地址" ToolTip="内核测延迟、连通性测试与自动选路使用的探测地址；下载测速使用内置地址，与此无关。修改后点「保存」，自动选路在重启内核后生效"
                                       FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBox Text="{Binding LatencyUrlText, UpdateSourceTrigger=PropertyChanged}" Width="210" Padding="6,3" FontSize="12"
                                         Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" VerticalContentAlignment="Center" />
                                <Button Content="保存" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding ApplyLatencyCommand}" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="16,0" />
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="延迟测试超时" ToolTip="单节点延迟测试的超时时间（毫秒），不影响下载测速"
                                       FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBox Text="{Binding LatencyTimeoutText, UpdateSourceTrigger=PropertyChanged}" Width="70" Padding="6,3" FontFamily="{DynamicResource FontMono}" FontSize="12"
                                         Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" VerticalContentAlignment="Center" />
                                <TextBlock Text=" ms" Style="{StaticResource SubText}" Margin="4,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="16,0" />
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="订阅 User-Agent" ToolTip="机场按此标识识别客户端并下发对应格式的订阅；修改后对订阅点「更新」生效"
                                       FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBox Text="{Binding SubscriptionUserAgentText, UpdateSourceTrigger=PropertyChanged}" Width="150" Padding="6,3" FontSize="12"
                                         Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" VerticalContentAlignment="Center"
                                         ToolTip="机场常按 UA 下发不同节点列表，与 Clash Verge 保持一致可拿到完整节点" />
                                <Button Content="保存" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding ApplyUserAgentCommand}" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="16,0" />
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="数据目录" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button Content="打开" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding OpenFolderCommand}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="16,0" />
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="一键导入" ToolTip="记录网页「一键导入」链接交给哪个客户端处理；右侧按钮清除该记忆"
                                       FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button Content="清除记住的接收方" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Command="{Binding ResetImportChoiceCommand}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="16,0" />
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="重置" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button Content="清除全部订阅" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Foreground="{DynamicResource DangerBrush}" Command="{Binding ResetCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ===== 右列 ===== -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="更新" Style="{StaticResource GroupHeaderText}" />
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="代理内核" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="{Binding KernelMihomoLabel}" Style="{StaticResource GhostButton}" Command="{Binding KernelKindChanged}" CommandParameter="mihomo" />
                                <Button Content="{Binding KernelSingBoxLabel}" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding KernelKindChanged}" CommandParameter="singbox" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="16,0" />
                        <!-- 第二行恒显：展示"未选中"的那个内核的安装状态，并提供其下载按钮 -->
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="{Binding OtherKernelNameText}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding OtherKernelStatusText}" Style="{StaticResource SubText}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <Button Content="{Binding OtherKernelButtonText}" Style="{StaticResource GhostButton}" Command="{Binding DownloadOtherKernelCommand}" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="16,0" />
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="内核通道" ToolTip="稳定版 = 官方正式版；Alpha = 测试版，更新更频繁但稳定性较低"
                                       FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="{Binding ChannelStableLabel}" Style="{StaticResource GhostButton}" Command="{Binding CoreChannelChanged}" CommandParameter="stable"
                                        Visibility="{Binding HasStableChannel, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <Button Content="{Binding ChannelAlphaLabel}" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding CoreChannelChanged}" CommandParameter="alpha"
                                        Visibility="{Binding HasAlphaChannel, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="16,0" />
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="内核版本" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding KernelStatusText}" Style="{StaticResource SubText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="16,0" />
                        <Grid Margin="16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding UpdateStatusText}" Style="{StaticResource SubText}" TextWrapping="Wrap" />
                                <Border Height="4" CornerRadius="2" Background="{DynamicResource SeparatorBrush}" Margin="0,8,0,0"
                                        Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding UpdateProgress, Converter={StaticResource PercentToGridLengthConverter}}" />
                                            <ColumnDefinition Width="{Binding UpdateRemainder, Converter={StaticResource PercentToGridLengthConverter}}" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="2" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Content="检查更新" Style="{StaticResource GhostButton}" Command="{Binding CheckUpdateCommand}" />
                                <Button Content="{Binding UpdateButtonText}" Margin="8,0,0,0"
                                        Style="{StaticResource GhostButton}" Command="{Binding UpdateKernelCommand}"
                                        Visibility="{Binding IsUpdating, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="关于" Style="{StaticResource GroupHeaderText}" Margin="16,22,0,8" />
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="版本" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding AppVersionText}" Style="{StaticResource SubText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{DynamicResource FontMono}" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="16,0" />
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="内核" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding KernelDisplayName}" Style="{StaticResource SubText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Border Height="1" Background="{DynamicResource SeparatorBrush}" Margin="16,0" />
                        <Grid Height="40" Margin="16,0">
                            <TextBlock Text="数据目录" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DataFolder}" Style="{StaticResource SubText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="260" ToolTip="{Binding DataFolder}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
