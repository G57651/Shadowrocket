<Window x:Class="Shadowrocket.Views.SchemeImportDialog" Icon="pack://application:,,,/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="一键导入" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource PageBgBrush}"
        FontFamily="{DynamicResource FontDefault}">
    <StackPanel Margin="20">
        <TextBlock Text="检测到一键导入链接" FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="10,7" Margin="0,10,0,0"
                BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1">
            <TextBlock x:Name="UrlText" TextTrimming="CharacterEllipsis" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </Border>

        <CheckBox x:Name="RememberBox" Content="记住我的选择（可到 设置 → 高级 清除）" Margin="0,14,0,0"
                  Foreground="{DynamicResource TextPrimaryBrush}" />

        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HintText" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                       TextWrapping="Wrap" FontSize="12" Margin="0,0,8,0" />
            <Button x:Name="ForwardButton" Grid.Column="1" Style="{StaticResource GhostButton}" Click="Forward_Click" />
            <Button Grid.Column="2" Content="取消" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Cancel_Click" />
            <Button Grid.Column="3" Content="导入到本软件" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Self_Click" />
        </Grid>
    </StackPanel>
</Window>
