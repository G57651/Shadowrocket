<Window x:Class="Shadowrocket.Views.RulesDialog" Icon="pack://application:,,,/app.ico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="规则" Width="760" Height="620" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBgBrush}" FontFamily="{DynamicResource FontDefault}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBox x:Name="SearchBox" Padding="8,6" FontSize="13" VerticalContentAlignment="Center"
                     Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                     TextChanged="SearchBox_TextChanged" />
        </Grid>

        <!-- 规则测试（客户端按规则表顺序模拟匹配） -->
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="规则测试" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBox x:Name="TestInput" Grid.Column="1" Margin="12,0" Padding="8,6" FontSize="13"
                         VerticalContentAlignment="Center"
                         Background="{DynamicResource PageBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1"
                         KeyDown="TestInput_KeyDown" />
                <Button Grid.Column="2" Content="测试" Style="{StaticResource GhostButton}" Click="Test_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="4">
            <ListView x:Name="RulesList" BorderThickness="0" Background="Transparent" FontSize="12.5"
                      ItemContainerStyle="{StaticResource ListViewItemStyle}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="#" Width="52" DisplayMemberBinding="{Binding Index}" />
                        <GridViewColumn Header="类型" Width="140" DisplayMemberBinding="{Binding Type}" />
                        <GridViewColumn Header="内容" Width="330" DisplayMemberBinding="{Binding Payload}" />
                        <GridViewColumn Header="出站" Width="170" DisplayMemberBinding="{Binding Proxy}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock x:Name="TestResult" Grid.Row="3" Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource AccentBrush}" />
    </Grid>
</Window>
