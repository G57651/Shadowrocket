<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 浅色主题令牌（docs/ui-spec.md §1.1） ============ -->

    <Color x:Key="ColorBrand">#2C6FCF</Color>
    <Color x:Key="ColorBrandDeep">#1B62C0</Color>
    <Color x:Key="ColorBrandSelected">#3C7FE0</Color>
    <Color x:Key="ColorPageBg">#F2F2F7</Color>
    <Color x:Key="ColorCard">#FFFFFF</Color>
    <Color x:Key="ColorSeparator">#E5E5EA</Color>
    <Color x:Key="ColorTextPrimary">#000000</Color>
    <Color x:Key="ColorTextSecondary">#8E8E93</Color>
    <Color x:Key="ColorTextTertiary">#C7C7CC</Color>
    <Color x:Key="ColorAccent">#0A84FF</Color>
    <Color x:Key="ColorAccentSoft">#E8F1FD</Color>
    <Color x:Key="ColorSuccess">#34C759</Color>
    <Color x:Key="ColorWarning">#FF9500</Color>
    <Color x:Key="ColorDanger">#FF3B30</Color>
    <Color x:Key="ColorChartDown">#0A84FF</Color>
    <Color x:Key="ColorChartUp">#32ADE6</Color>
    <Color x:Key="ColorChartGrid">#E3EDF9</Color>
    <Color x:Key="ColorSwitchOff">#E9E9EB</Color>
    <Color x:Key="ColorTagBg">#F0F0F5</Color>
    <Color x:Key="ColorSegmentTrack">#EDEDF2</Color>

    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource ColorBrand}" />
    <SolidColorBrush x:Key="BrandDeepBrush" Color="{StaticResource ColorBrandDeep}" />
    <SolidColorBrush x:Key="BrandSelectedBrush" Color="{StaticResource ColorBrandSelected}" />
    <SolidColorBrush x:Key="PageBgBrush" Color="{StaticResource ColorPageBg}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource ColorCard}" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource ColorSeparator}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource ColorTextTertiary}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource ColorAccentSoft}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="ChartDownBrush" Color="{StaticResource ColorChartDown}" />
    <SolidColorBrush x:Key="ChartUpBrush" Color="{StaticResource ColorChartUp}" />
    <SolidColorBrush x:Key="ChartGridBrush" Color="{StaticResource ColorChartGrid}" />
    <SolidColorBrush x:Key="SwitchOffBrush" Color="{StaticResource ColorSwitchOff}" />
    <SolidColorBrush x:Key="TagBgBrush" Color="{StaticResource ColorTagBg}" />
    <SolidColorBrush x:Key="SegmentTrackBrush" Color="{StaticResource ColorSegmentTrack}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF" />

    <!-- 阴影 -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.10" Color="#1B2A4A" />

    <!-- 字体 -->
    <FontFamily x:Key="FontDefault">Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizePageTitle">17</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeBig">28</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeBody">15</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeRowValue">14</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeSecondary">12</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeGroupHeader">13</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeBadge">11</sys:Double>

    <!-- 圆角 -->
    <CornerRadius x:Key="RadiusCard">10</CornerRadius>
    <CornerRadius x:Key="RadiusNodeCard">8</CornerRadius>
    <CornerRadius x:Key="RadiusIconDisc">7</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>
    <CornerRadius x:Key="RadiusSegment">16</CornerRadius>
    <CornerRadius x:Key="RadiusButton">6</CornerRadius>

</ResourceDictionary>
